# Todas as opções são prefixadas por HIVEMIND_. Nunca comite o arquivo .env.
HIVEMIND_DEMO_MODE=true
# Opcional em demo local; obrigatório em modo real. Gere um token >=32 caracteres.
# HIVEMIND_API_TOKEN=
# Configure somente as chaves dos provedores que deseja ativar.
# HIVEMIND_ANTHROPIC_API_KEY=
# HIVEMIND_OPENAI_API_KEY=
# HIVEMIND_GOOGLE_API_KEY=
HIVEMIND_CLAUDE_MODEL=claude-sonnet-5-5
HIVEMIND_OPENAI_MODEL=gpt-6-luna
# Esforço de raciocínio da OpenAI: none, minimal, low, medium, high, xhigh ou max.
# Deixe vazio ao usar um modelo sem raciocínio (ex.: gpt-4.1-mini).
HIVEMIND_OPENAI_REASONING_EFFORT=none
HIVEMIND_GEMINI_MODEL=gemini-3.5-flash
# Timeout por piloto e limite de ciclos por tarefa (1..10).
HIVEMIND_AGENT_TIMEOUT_SECONDS=30
HIVEMIND_MAX_CYCLES=2
# Diretório local confiável e quantidade de memórias recuperadas.
HIVEMIND_MEMORY_PATH=data/chroma
HIVEMIND_MEMORY_TOP_K=3
# Arquivo JSON local do grafo usado pela simulação CLI offline.
HIVEMIND_GRAPH_PATH=data/knowledge_graph.json
# Retenção em RAM e limite de tarefas ativas (não é fila distribuída).
HIVEMIND_MAX_TASKS=100
HIVEMIND_MAX_CONCURRENT_TASKS=4
HIVEMIND_SHUTDOWN_TIMEOUT_SECONDS=10
